{
  "name": "nkuku-companion-app",
  "version": "1.42.0-alpha",
  "private": true,
  "description": "Nkuku Companion App — broiler chicken business management platform",
  "scripts": {
    "dev": "docker compose up",
    "dev:build": "docker compose up --build",
    "dev:down": "docker compose down -v",
    "dev:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml up --build",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed",
    "db:studio": "pnpm --filter api db:studio",
    "db:generate": "pnpm --filter api db:generate",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.26",
      "sharp": ">=0.35.0",
      "uuid": ">=11.1.1",
      "brace-expansion@5": ">=5.0.11",
      "minimatch@3>brace-expansion": ">=1.1.19 <2",
      "minimatch@5>brace-expansion": ">=2.1.5 <3",
      "minimatch@9>brace-expansion": ">=4.0.1 <5",
      "fast-uri": ">=4.1.5",
      "postcss-selector-parser": ">=7.1.6",
      "source-map-js": ">=1.2.2"
    }
  }
}
