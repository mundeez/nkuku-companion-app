# Copy this file to `key.properties` and fill in your release keystore details.
# DO NOT commit `key.properties` or your `.keystore`/`.jks` file.
#
# Generate a release keystore:
#   keytool -genkey -v -keystore release.keystore -alias nkuku \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# Then fill in the paths and passwords below.
storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=nkuku
storeFile=../release.keystore
