# Base URL of the Nkuku API host (tenant app + API live on the same host).
# The platform console calls <API_URL>/api/v1/platform/*.
NEXT_PUBLIC_API_URL=https://nkuku.zeendeefood.solutions

# Tenant web app URL — used for the "Open tenant app as this user"
# impersonation link (/?impersonate=<token>).
NEXT_PUBLIC_TENANT_APP_URL=https://nkuku.zeendeefood.solutions
