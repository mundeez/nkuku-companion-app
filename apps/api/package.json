{
  "name": "api",
  "version": "1.25.0-alpha",
  "private": true,
  "description": "Nkuku Companion API — Fastify + Prisma + PostgreSQL",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx src/db/seeds/main.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1102.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^5.8.0",
    "bcryptjs": "^2.4.3",
    "clamscan": "^2.4.0",
    "csv-stringify": "^6.4.6",
    "decimal.js": "^10.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.1",
    "fastify-type-provider-zod": "^5.1.0",
    "google-auth-library": "^11.0.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pdfkit": "^0.15.0",
    "tesseract.js": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.14",
    "@types/pdfkit": "^0.13.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.15.0",
    "prisma": "^5.8.0",
    "supertest": "^6.3.3",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx src/db/seeds/main.ts"
  },
  "type": "module"
}
