// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── AUTH / RBAC ──────────────────────────
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String?  @unique // nullable — phone-only users may not have email
  phone        String?  @unique @db.VarChar(20) // E.164 format, e.g. "260970000000"
  passwordHash String   @map("password_hash") // may be empty for OTP-only users
  role         Role     @default(viewer)
  name         String?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Phone verification timestamp — set when phone OTP is verified.
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  // Email verification timestamp — for future email verification flow.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)

  // Zambia Data Protection Act (No. 3 of 2021) consent tracking — captured
  // at signup/invite-accept time. See docs/MONETIZATION_PLAN.md Phase 2.
  consentAcceptedAt DateTime? @map("consent_accepted_at") @db.Timestamptz(6)
  consentVersion    String?   @map("consent_version") @db.VarChar(20)

  createdSuppliers                    Supplier[]                    @relation("SupplierCreatedBy")
  createdBatches                      Batch[]                       @relation("BatchCreatedBy")
  createdCycles                       ProductionCycle[]             @relation("CycleCreatedBy")
  createdFlocks                       BroilerFlock[]                @relation("FlockCreatedBy")
  monthlyOverheads                    MonthlyOverhead[]
  createdLightingTemperatureSchedules LightingTemperatureSchedule[] @relation("LightingTemperatureScheduleCreatedBy")
  uploadedDocuments                   Document[]                    @relation("DocumentUploadedBy")
  createdSaleRecords                  SaleRecord[]                  @relation("SaleRecordCreatedBy")
  createdFeedPurchases                FeedPurchase[]                @relation("FeedPurchaseCreatedBy")
  memberships                         OrganizationMember[]
  sentInvites                         Invite[]                      @relation("InviteInvitedBy")
  otpCodes                            OtpCode[]
  devices                             UserDevice[]
  socialAccounts                      SocialAccount[]

  @@map("users")
}

// ── SOCIAL ACCOUNTS ──────────────────────
// Links a User to an external identity provider (Google, Facebook, Apple,
// Microsoft). A user may have multiple linked providers. The combination
// of (provider, providerUserId) is unique — one social identity maps to
// exactly one Nkuku user.
model SocialAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  provider       String   @db.VarChar(20) // "google" | "facebook" | "apple" | "microsoft"
  providerUserId String   @map("provider_user_id") @db.VarChar(255) // provider's unique user ID
  providerEmail  String?  @map("provider_email") @db.VarChar(255) // email from provider (may differ from User.email)
  providerName   String?  @map("provider_name") @db.VarChar(255) // display name from provider
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("social_accounts")
}

// ── OTP VERIFICATION ─────────────────────
// Stores OTP codes for phone verification (signup, login, new device).
// Codes are hashed (SHA-256) so a DB compromise doesn't reveal live codes.
model OtpCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid // null for signup OTPs (user not yet created)
  phone     String   @db.VarChar(20) // E.164 format
  codeHash  String   @map("code_hash") @db.VarChar(64) // SHA-256 hex
  purpose   String   @db.VarChar(20) // "signup" | "login" | "new_device"
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@map("otp_codes")
}

// ── DEVICE TRACKING ──────────────────────
// Tracks recognized devices per user for new-device OTP re-verification.
// A device fingerprint is derived from user-agent + IP hash (web) or
// a generated device ID (mobile).
model UserDevice {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  deviceFingerprint String @map("device_fingerprint") @db.VarChar(64)
  deviceLabel   String?  @map("device_label") @db.VarChar(200) // e.g. "Chrome on Windows"
  lastSeenAt    DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceFingerprint])
  @@map("user_devices")
}

enum Role {
  owner
  manager
  flock_minder
  sales_person
  viewer
}

// ── MULTI-TENANCY: ORGANIZATIONS ─────────
// An Organization represents one paying customer / farm business.
// Every tenant-scoped record (flocks, suppliers, ledger, documents, etc.)
// carries an organizationId. Shared reference/catalog data (breeds,
// performance targets, diseases, vaccination schedule templates, equipment
// catalog) remains global and is NOT organization-scoped.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(150)
  country   String   @db.VarChar(2) // ISO 3166-1 alpha-2, e.g. "ZM", "BW"
  currency  String   @default("ZMW") @map("currency") @db.Char(3)
  planCode  String   @default("free") @map("plan_code") @db.VarChar(30)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  members                      OrganizationMember[]
  invites                      Invite[]
  suppliers                    Supplier[]
  cycles                       ProductionCycle[]
  flocks                       BroilerFlock[]
  documents                    Document[]
  monthlyOverheads             MonthlyOverhead[]
  lightingTemperatureSchedules LightingTemperatureSchedule[]
  saleRecords                  SaleRecord[]
  journalEntries               JournalEntry[]
  batches                      Batch[]
  subscriptions                Subscription[]
  invoices                     Invoice[]
  feedPurchases                FeedPurchase[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role     @default(viewer)
  joinedAt       DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// Pending invitation to join an organization. The invited person does not
// need an existing account — accepting the invite creates their User (or
// links to their existing one, if the email already has an account).
model Invite {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String    @db.VarChar(255)
  role           Role      @default(viewer)
  token          String    @unique @db.VarChar(64)
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InviteInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invites")
}

// ── MULTI-TENANCY: BILLING (Phase 3 scaffolding) ─
model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  planCode           String             @map("plan_code") @db.VarChar(30)
  billingCycle       BillingCycle       @default(monthly) @map("billing_cycle")
  status             SubscriptionStatus @default(trialing)
  currentPeriodStart DateTime?          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(6)
  provider           String?            @db.VarChar(30) // e.g. "flutterwave"
  providerRef        String?            @map("provider_ref") @db.VarChar(100)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  @@index([organizationId])
  @@map("subscriptions")
}

enum BillingCycle {
  monthly
  cycle_3mo
  annual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  suspended
  cancelled
}

// An invoice generated for a subscription period. One invoice per billing
// cycle per subscription. Tracks the amount due, amount paid, and status.
model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  subscriptionId   String        @map("subscription_id") @db.Uuid
  invoiceNumber    String        @unique @map("invoice_number") @db.VarChar(50)
  planCode         String        @map("plan_code") @db.VarChar(30)
  billingCycle     BillingCycle  @map("billing_cycle")
  amountDue        Decimal       @map("amount_due") @db.Decimal(12, 2)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  currency         String        @default("ZMW") @db.Char(3)
  status           InvoiceStatus @default(draft)
  periodStart      DateTime      @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime      @map("period_end") @db.Timestamptz(6)
  dueDate          DateTime      @map("due_date") @db.Timestamptz(6)
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz(6)
  providerRef      String?       @unique @map("provider_ref") @db.VarChar(100) // Flutterwave tx ref
  paymentLink      String?       @map("payment_link") @db.Text // Flutterwave checkout URL
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentEvents PaymentEvent[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@map("invoices")
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

// A payment event from Flutterwave (webhook or manual verification).
// Multiple events can map to one invoice (e.g. pending → success).
model PaymentEvent {
  id              String   @id @default(uuid()) @db.Uuid
  invoiceId       String   @map("invoice_id") @db.Uuid
  provider        String   @db.VarChar(30) // "flutterwave"
  providerRef     String   @map("provider_ref") @db.VarChar(100) // tx_ref
  providerTxnId   String?  @map("provider_txn_id") @db.VarChar(100) // flw_tx_ref
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("ZMW") @db.Char(3)
  status          String   @db.VarChar(20) // "success", "failed", "pending", "cancelled"
  rawPayload      Json?    @map("raw_payload") // full webhook payload for audit
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([providerRef])
  @@map("payment_events")
}

// ── SUPPLIERS ────────────────────────────
model Supplier {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String   @unique @db.VarChar(100)
  description    String?  @db.Text
  chickenType    String?  @map("chicken_type") @db.VarChar(50)
  contact        String?  @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  isDefault      Boolean  @default(false) @map("is_default")
  createdBy      String?  @map("created_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  feedStages   FeedStage[]
  feedRecords  FeedRecord[]
  feedPurchases FeedPurchase[]
  flocks       BroilerFlock[]
  batches      Batch[]
  projections  Projection[]
  creator      User?          @relation("SupplierCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@map("suppliers")
}

// ── FEED STAGES ──────────────────────────
model FeedStage {
  id              String    @id @default(uuid()) @db.Uuid
  supplierId      String    @map("supplier_id") @db.Uuid
  stageName       String    @map("stage_name") @db.VarChar(50)
  stageType       StageType @default(feed) @map("stage_type")
  dayRangeStart   Int?      @map("day_range_start")
  dayRangeEnd     Int?      @map("day_range_end")
  unitSizeKg      Decimal   @map("unit_size_kg") @db.Decimal(10, 3)
  unitPriceZmw    Decimal   @map("unit_price_zmw") @db.Decimal(12, 2)
  intakePerBirdKg Decimal   @map("intake_per_bird_kg") @db.Decimal(8, 4)
  sortOrder       Int       @default(0) @map("sort_order")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  supplier      Supplier                @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  batchExpenses BatchExpense[]
  priceHistory  FeedStagePriceHistory[]
  feedPurchases FeedPurchase[]

  @@unique([supplierId, stageName])
  @@index([supplierId, sortOrder])
  @@map("feed_stages")
}

// ── FEED STAGE PRICE HISTORY ───────────────
// Audit trail of every unitPriceZmw change on a FeedStage.
// Records the old price, new price, who changed it, and when.
// This ensures historical pricing is preserved for accountability
// even after a supplier's current price is updated.
model FeedStagePriceHistory {
  id              String   @id @default(uuid()) @db.Uuid
  feedStageId     String   @map("feed_stage_id") @db.Uuid
  oldUnitPriceZmw Decimal  @map("old_unit_price_zmw") @db.Decimal(12, 2)
  newUnitPriceZmw Decimal  @map("new_unit_price_zmw") @db.Decimal(12, 2)
  oldUnitSizeKg   Decimal  @map("old_unit_size_kg") @db.Decimal(10, 3)
  newUnitSizeKg   Decimal  @map("new_unit_size_kg") @db.Decimal(10, 3)
  changedBy       String?  @map("changed_by") @db.Uuid
  changedAt       DateTime @default(now()) @map("changed_at") @db.Timestamptz(6)

  feedStage FeedStage @relation(fields: [feedStageId], references: [id], onDelete: Cascade)

  @@index([feedStageId, changedAt])
  @@map("feed_stage_price_history")
}

enum StageType {
  feed
  chick
  medication
  other
}

// ── SUPPLIER CATEGORY TEMPLATES ──────────
model SupplierCategoryTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @db.VarChar(50)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items SupplierCategoryTemplateItem[]

  @@unique([category])
  @@index([sortOrder])
  @@map("supplier_category_templates")
}

model SupplierCategoryTemplateItem {
  id            String    @id @default(uuid()) @db.Uuid
  templateId    String    @map("template_id") @db.Uuid
  itemName      String    @map("item_name") @db.VarChar(50)
  itemType      StageType @default(feed) @map("item_type")
  sortOrder     Int       @default(0) @map("sort_order")
  defaultFields Json?     @map("default_fields")
  isRequired    Boolean   @default(true) @map("is_required")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  template SupplierCategoryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, itemName])
  @@index([templateId, sortOrder])
  @@map("supplier_category_template_items")
}

// ── PRODUCTION CYCLES ────────────────────
model ProductionCycle {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  cycleNumber    Int         @unique @map("cycle_number")
  label          String?     @db.VarChar(50)
  notes          String?     @db.Text
  status         CycleStatus @default(planned)
  createdBy      String?     @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  batches      Batch[]
  creator      User?        @relation("CycleCreatedBy", fields: [createdBy], references: [id])

  @@index([organizationId])
  @@map("production_cycles")
}

enum CycleStatus {
  planned
  active
  completed
}

// ── BATCHES (SHOOTS) ─────────────────────
model Batch {
  id                  String      @id @default(uuid()) @db.Uuid
  organizationId      String      @map("organization_id") @db.Uuid
  cycleId             String      @map("cycle_id") @db.Uuid
  supplierId          String      @map("supplier_id") @db.Uuid
  shootLabel          String      @map("shoot_label") @db.VarChar(20)
  targetExecutionDt   DateTime    @map("target_execution_dt") @db.Date
  salesDate           DateTime    @map("sales_date") @db.Date
  growthQtyAdded      Int         @default(0) @map("growth_qty_added")
  totalQtyAtHand      Int         @map("total_qty_at_hand")
  revenueTargetZmw    Decimal?    @map("revenue_target_zmw") @db.Decimal(14, 2)
  salesPricePerBird   Decimal?    @map("sales_price_per_bird") @db.Decimal(10, 2)
  actualBirdsSold     Int?        @map("actual_birds_sold")
  actualSalePrice     Decimal?    @map("actual_sale_price") @db.Decimal(10, 2)
  mortalityPctAssumed Decimal     @default(0.0500) @map("mortality_pct_assumed") @db.Decimal(5, 4)
  status              BatchStatus @default(planned)
  createdBy           String?     @map("created_by") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  cycle            ProductionCycle   @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  expenses         BatchExpense[]
  overheadCosts    OverheadCost[]
  mortalityRecords MortalityRecord[]
  projections      Projection[]
  creator          User?             @relation("BatchCreatedBy", fields: [createdBy], references: [id])

  @@index([cycleId, shootLabel])
  @@index([organizationId])
  @@map("batches")
}

enum BatchStatus {
  planned
  active
  harvested
  closed
}

// ── BATCH EXPENSES ───────────────────────
model BatchExpense {
  id                String          @id @default(uuid()) @db.Uuid
  batchId           String          @map("batch_id") @db.Uuid
  feedStageId       String?         @map("feed_stage_id") @db.Uuid
  expenseCategory   ExpenseCategory @default(feed) @map("expense_category")
  description       String?         @db.VarChar(200)
  quantityItems     Decimal?        @map("quantity_items") @db.Decimal(12, 4)
  quantityRoundedUp Int?            @map("quantity_rounded_up")
  unitPriceZmw      Decimal         @map("unit_price_zmw") @db.Decimal(12, 2)
  subtotalZmw       Decimal         @map("subtotal_zmw") @db.Decimal(14, 2)
  isProjected       Boolean         @default(true) @map("is_projected")
  recordedAt        DateTime        @default(now()) @map("recorded_at") @db.Timestamptz(6)

  batch     Batch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  feedStage FeedStage? @relation(fields: [feedStageId], references: [id])

  @@index([batchId])
  @@map("batch_expenses")
}

enum ExpenseCategory {
  feed
  chick
  medication
  labor
  utilities
  transport
  other
}

// ── OVERHEAD COSTS ───────────────────────
model OverheadCost {
  id          String           @id @default(uuid()) @db.Uuid
  batchId     String           @map("batch_id") @db.Uuid
  category    OverheadCategory
  description String?          @db.VarChar(200)
  amountZmw   Decimal          @map("amount_zmw") @db.Decimal(14, 2)
  isProjected Boolean          @default(true) @map("is_projected")
  notes       String?          @db.Text
  recordedAt  DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("overhead_costs")
}

enum OverheadCategory {
  medication
  vaccination
  labour
  electricity
  water
  litter
  transport_to_market
  other
}

// ── MORTALITY RECORDS ────────────────────
model MortalityRecord {
  id         String   @id @default(uuid()) @db.Uuid
  batchId    String   @map("batch_id") @db.Uuid
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(6)
  dayOfCycle Int?     @map("day_of_cycle")
  birdsLost  Int      @default(0) @map("birds_lost")
  cause      String?  @db.VarChar(100)
  notes      String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, recordedAt])
  @@map("mortality_records")
}

// ── PROJECTIONS ──────────────────────────
model Projection {
  id                 String   @id @default(uuid()) @db.Uuid
  batchId            String   @map("batch_id") @db.Uuid
  supplierId         String   @map("supplier_id") @db.Uuid
  birdCount          Int      @map("bird_count")
  salesPricePerBird  Decimal  @map("sales_price_per_bird") @db.Decimal(10, 2)
  mortalityPct       Decimal  @default(0.0500) @map("mortality_pct") @db.Decimal(5, 4)
  effectiveBirdCount Decimal  @map("effective_bird_count") @db.Decimal(12, 2)
  totalFeedCost      Decimal  @map("total_feed_cost") @db.Decimal(14, 2)
  totalChickCost     Decimal  @map("total_chick_cost") @db.Decimal(14, 2)
  totalOverheadCost  Decimal? @map("total_overhead_cost") @db.Decimal(14, 2)
  totalExpenses      Decimal  @map("total_expenses") @db.Decimal(14, 2)
  projectedRevenue   Decimal  @map("projected_revenue") @db.Decimal(14, 2)
  grossProfit        Decimal  @map("gross_profit") @db.Decimal(14, 2)
