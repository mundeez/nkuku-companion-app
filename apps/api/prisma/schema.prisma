  id         String     @id @default(uuid()) @db.Uuid
  label      String     @db.VarChar(20)
  periodType PeriodType @map("period_type")
  startDate  DateTime   @map("start_date") @db.Date
  endDate    DateTime   @map("end_date") @db.Date
  isClosed   Boolean    @default(false) @map("is_closed")
  closedAt   DateTime?  @map("closed_at") @db.Timestamptz(6)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  auditLogs AuditLog[]

  @@unique([label, periodType])
  @@index([startDate, endDate])
  @@map("financial_periods")
}

enum PeriodType {
  monthly
  quarterly
  annual
}

// ── AUDIT LOG ────────────────────────────
model AuditLog {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  entityType    String      @map("entity_type") @db.VarChar(50)
  entityId      String      @map("entity_id") @db.Uuid
  action        AuditAction
  previousState Json?       @map("previous_state")
  newState      Json?       @map("new_state")
  ipAddress     String?     @map("ip_address") @db.VarChar(45)
  periodId      String?     @map("period_id") @db.Uuid
  occurredAt    DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(6)

  period FinancialPeriod? @relation(fields: [periodId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, occurredAt])
  @@map("audit_logs")
}

enum AuditAction {
  create
  update
  delete
  period_close
  report_generate
  virus_scan_rejected
}

// ── SCHEDULED REPORTS ────────────────────
model ScheduledReport {
  id         String          @id @default(uuid()) @db.Uuid
  name       String          @db.VarChar(100)
  reportType ReportType      @map("report_type")
  frequency  ReportFrequency
  scope      ReportScope
  scopeId    String?         @map("scope_id") @db.Uuid
  recipients Json
  format     ExportFormat
  isActive   Boolean         @default(true) @map("is_active")
  lastRunAt  DateTime?       @map("last_run_at") @db.Timestamptz(6)
  nextRunAt  DateTime?       @map("next_run_at") @db.Timestamptz(6)
  createdBy  String          @map("created_by") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  executions ReportExecution[]

  @@map("scheduled_reports")
}

model ReportExecution {
  id                String          @id @default(uuid()) @db.Uuid
  scheduledReportId String          @map("scheduled_report_id") @db.Uuid
  status            ExecutionStatus
  fileUrl           String?         @db.VarChar(500)
  errorMessage      String?         @map("error_message") @db.Text
  executedAt        DateTime        @default(now()) @map("executed_at") @db.Timestamptz(6)

  scheduledReport ScheduledReport @relation(fields: [scheduledReportId], references: [id], onDelete: Cascade)

  @@index([scheduledReportId, executedAt])
  @@map("report_executions")
}

enum ReportType {
  income_statement
  balance_sheet
  cash_flow
  cost_breakdown
  flock_profitability
  cycle_summary
}

enum ReportFrequency {
  weekly
  monthly
  quarterly
}

enum ReportScope {
  global
  flock
  cycle
}

enum ExportFormat {
  pdf
  csv
  excel
}

enum ExecutionStatus {
  success
  failed
  running
}

// ── MONTHLY OVERHEADS ────────────────────
model MonthlyOverhead {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  yearMonth      String           @map("year_month") @db.VarChar(7)
  category       OverheadCategory @map("category")
  description    String?          @db.VarChar(200)
  amountZmw      Decimal          @map("amount_zmw") @db.Decimal(14, 2)
  contractType   String           @map("contract_type") @db.VarChar(20)
  recordedAt     DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  createdBy      String           @map("created_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [createdBy], references: [id])

  @@unique([organizationId, yearMonth, category, description])
  @@index([organizationId])
  @@map("monthly_overheads")
}

// ── FLOCK OVERHEAD ALLOCATIONS ───────────
model FlockOverheadAllocation {
  id                   String   @id @default(uuid()) @db.Uuid
  monthlyOverheadId    String   @map("monthly_overhead_id") @db.Uuid
  flockId              String   @map("flock_id") @db.Uuid
  allocationDate       DateTime @map("allocation_date") @db.Date
  daysActiveInMonth    Int      @map("days_active_in_month")
  totalActiveFlockDays Int      @map("total_active_flock_days")
  allocatedAmount      Decimal  @map("allocated_amount") @db.Decimal(14, 2)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([flockId, allocationDate])
  @@map("flock_overhead_allocations")
}

// NOTE: The chart of accounts is deliberately NOT organization-scoped.
// Standard account codes (1010 Cash, 4010 Bird Sales, etc.) are a shared
// reference catalog, the same way Breed/Disease/EquipmentItem are — not
// something each tenant customizes today. What IS organization-scoped is
// the transactional data that references these accounts (JournalEntry),
// which carries its own organizationId. Scoping Account itself per-org
// would require every core double-entry service (ledger, GAAP statements,
// period close) to thread organizationId through account lookups, which is
// a larger, separate effort than Phase 1's data-isolation goal.
// ── DOUBLE-ENTRY: CHART OF ACCOUNTS ──────
model Account {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique @db.VarChar(10)
  name          String        @db.VarChar(100)
  accountType   AccountType   @map("account_type")
  normalBalance NormalBalance @map("normal_balance")
  parentCode    String?       @map("parent_code") @db.VarChar(10)
  description   String?       @db.Text
  isActive      Boolean       @default(true) @map("is_active")
  isSystem      Boolean       @default(false) @map("is_system")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  journalLines JournalLine[]

  @@index([accountType])
  @@map("accounts")
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum NormalBalance {
  debit
  credit
}

// ── DOUBLE-ENTRY: JOURNAL ENTRIES ────────
model JournalEntry {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  entryNumber    String            @map("entry_number") @db.VarChar(20)
  entryDate      DateTime          @map("entry_date") @db.Date
  description    String            @db.VarChar(300)
  reference      String?           @db.VarChar(100)
  sourceType     JournalSourceType @map("source_type")
  sourceId       String?           @map("source_id") @db.Uuid
  periodLabel    String?           @map("period_label") @db.VarChar(20)
  isReversing    Boolean           @default(false) @map("is_reversing")
  reversesId     String?           @map("reverses_id") @db.Uuid
  postedBy       String?           @map("posted_by") @db.Uuid
  postedAt       DateTime          @default(now()) @map("posted_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  lines        JournalLine[]
  reversedBy   JournalEntry?  @relation("ReversalOf", fields: [reversesId], references: [id])
  reversals    JournalEntry[] @relation("ReversalOf")
  documents    Document[]

  @@unique([organizationId, entryNumber])
  @@index([entryDate, periodLabel])
  @@index([sourceType, sourceId])
  @@index([organizationId])
  @@map("journal_entries")
}

enum JournalSourceType {
  manual
  feed_record
  vaccination_event
  mortality_event
  water_record
  batch_expense
  overhead_cost
  sales
  migration
  period_close
}

// ── DOUBLE-ENTRY: JOURNAL LINES ──────────
model JournalLine {
  id          String   @id @default(uuid()) @db.Uuid
  journalId   String   @map("journal_id") @db.Uuid
  accountId   String   @map("account_id") @db.Uuid
  debitZmw    Decimal? @map("debit_zmw") @db.Decimal(14, 2)
  creditZmw   Decimal? @map("credit_zmw") @db.Decimal(14, 2)
  description String?  @db.VarChar(200)
  flockId     String?  @map("flock_id") @db.Uuid
  batchId     String?  @map("batch_id") @db.Uuid

  journal JournalEntry @relation(fields: [journalId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])

  @@index([journalId])
  @@index([accountId])
  @@map("journal_lines")
}

// ── DOUBLE-ENTRY: LEDGER BALANCES ────────
model LedgerBalance {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  accountId      String   @map("account_id") @db.Uuid
  periodLabel    String   @map("period_label") @db.VarChar(20)
  openingDebit   Decimal  @default(0) @map("opening_debit") @db.Decimal(14, 2)
  openingCredit  Decimal  @default(0) @map("opening_credit") @db.Decimal(14, 2)
  periodDebit    Decimal  @default(0) @map("period_debit") @db.Decimal(14, 2)
  periodCredit   Decimal  @default(0) @map("period_credit") @db.Decimal(14, 2)
  closingDebit   Decimal  @default(0) @map("closing_debit") @db.Decimal(14, 2)
  closingCredit  Decimal  @default(0) @map("closing_credit") @db.Decimal(14, 2)
  computedAt     DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@unique([organizationId, accountId, periodLabel])
  @@index([organizationId])
  @@map("ledger_balances")
}

// ── DOCUMENTS (receipts, quotations, invoices, statements, contracts) ──

model Document {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  flockId          String?   @map("flock_id") @db.Uuid
  recordType       String    @map("record_type") @db.VarChar(50)
  recordId         String?   @map("record_id") @db.Uuid
  fileName         String    @map("file_name") @db.VarChar(255)
  filePath         String?   @map("file_path") @db.VarChar(500)
  storageKey       String?   @map("storage_key") @db.VarChar(500)
  bucket           String?   @db.VarChar(100)
  mimeType         String    @map("mime_type") @db.VarChar(100)
  fileSizeKb       Int       @map("file_size_kb")
  category         String    @db.VarChar(50)
  contentText      String?   @map("content_text") @db.Text
  scanStatus       String    @default("pending") @map("scan_status") @db.VarChar(20)
  scannedAt        DateTime? @map("scanned_at") @db.Timestamptz(6)
  extractionStatus String    @default("pending") @map("extraction_status") @db.VarChar(20)
  uploadedBy       String?   @map("uploaded_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // NOTE: `search_vector` (tsvector, GENERATED ALWAYS AS ... STORED) is
  // deliberately NOT declared here. Prisma cannot express a GENERATED
  // column: declaring it as a normal or Unsupported field makes `db push`
  // either try to (and fail to) alter it, or — worse — DROP it as
  // "unknown" if the schema omits it entirely. It is created/repaired
  // exclusively by prisma/sql/documents-search.sql, which MUST be re-run
  // after any `prisma db push` against this table (see AGENTS.md).

  // ── Direct FKs to financial transaction entities ──
  financialRecordId String? @map("financial_record_id") @db.Uuid
  journalEntryId    String? @map("journal_entry_id") @db.Uuid
  saleRecordId      String? @map("sale_record_id") @db.Uuid

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  flock           BroilerFlock?    @relation(fields: [flockId], references: [id], onDelete: Cascade)
  uploader        User?            @relation("DocumentUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)
  financialRecord FinancialRecord? @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  saleRecord      SaleRecord?      @relation(fields: [saleRecordId], references: [id], onDelete: Cascade)

  @@index([flockId, recordType])
  @@index([recordType, recordId])
  @@index([financialRecordId])
  @@index([journalEntryId])
  @@index([saleRecordId])
  @@index([organizationId])
  @@map("documents")
}

// ── SALE RECORDS ──────────────────────────────

model SaleRecord {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  flockId         String   @map("flock_id") @db.Uuid
  saleDate        DateTime @map("sale_date") @db.Date
  customerName    String?  @map("customer_name") @db.VarChar(200)
  customerPhone   String?  @map("customer_phone") @db.VarChar(50)
  birdCount       Int      @map("bird_count")
  avgWeightKg     Decimal? @map("avg_weight_kg") @db.Decimal(10, 3)
  pricePerBirdZmw Decimal  @map("price_per_bird_zmw") @db.Decimal(14, 2)
  totalAmountZmw  Decimal  @map("total_amount_zmw") @db.Decimal(14, 2)
  paymentStatus   String   @default("pending") @map("payment_status") @db.VarChar(20)
  amountPaidZmw   Decimal? @map("amount_paid_zmw") @db.Decimal(14, 2)
  notes           String?  @db.Text
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  flock        BroilerFlock @relation(fields: [flockId], references: [id], onDelete: Cascade)
  creator      User?        @relation("SaleRecordCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  documents    Document[]

  @@index([flockId, saleDate])
  @@index([saleDate])
  @@index([organizationId])
  @@map("sale_records")
}
