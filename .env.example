# ============================================================
# Nkuku Companion — Production Environment Variables
# Copy to .env and fill in real values before deployment
# ============================================================

# ── Database ───────────────────────────────
# Must be a strong password (min 32 chars recommended)
DB_PASSWORD=your_strong_postgres_password_here

# Full connection string (uses DB_PASSWORD above)
DATABASE_URL=postgresql://nkuku_user:your_strong_postgres_password_here@postgres:5432/nkuku_db

# ── Redis ──────────────────────────────────
REDIS_URL=redis://redis:6379

# ── JWT Secrets ────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_min_64_chars_change_me_immediately
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Default Owner Account ──────────────────
OWNER_EMAIL=owner@nkuku.local
OWNER_PASSWORD=change_me_immediately_after_first_login

# ── CORS ───────────────────────────────────
# Comma-separated list of allowed origins
# Include your domain, the mobile app origin (if any), and localhost for dev
CORS_ORIGINS=https://nkuku.deeztechnology.solutions

# ── Web App API URL ────────────────────────
# NEXT_PUBLIC_API_URL controls where the browser sends API requests.
# Leave EMPTY for production — the browser uses same-origin relative
# URLs (/api/v1/...) which nginx proxies to the backend.
# Do NOT set this to http://localhost:30001 in production — that would
# make users' browsers try to connect to their own machines.
NEXT_PUBLIC_API_URL=

# ── ntfy Notifications ─────────────────────
# Self-hosted ntfy server used by the API to publish push notifications.
# In dev, the docker-compose ntfy service is reachable at http://ntfy (internal)
# and at http://localhost:30085 from the host.
NTFY_BASE_URL=https://ntfy.deeztechnology.solutions
NTFY_DEFAULT_TOPIC=nkuku-alerts

# ── Mobile App API URL ─────────────────────
# Used in Flutter lib/services/api_service.dart
# In production the mobile app should call:
#   https://nkuku.deeztechnology.solutions/api/v1
# Update this in apps/mobile/lib/services/api_service.dart before building APK

# ── S3 / MinIO object storage (document attachments) ──
# Uses the shared pom-minio container on the shared-net network.
# Create a dedicated service account scoped to the nkuku-documents bucket:
#   see infra/minio/setup-nkuku-account.sh
S3_ENDPOINT=http://pom-minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=your_nkuku_app_access_key
S3_SECRET_KEY=your_nkuku_app_secret_key
S3_BUCKET=nkuku-documents
S3_FORCE_PATH_STYLE=true

# ── ClamAV virus scanning (document uploads) ──
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
REQUIRE_VIRUS_SCAN=true

# ── Document attachments limits ──
MAX_ATTACHMENTS_PER_TX=20

# ── Web base URL (used for generating invite links) ──
WEB_BASE_URL=http://localhost:30000

# ── Flutterwave (Payments / Billing) ───────
# Get these from https://dashboard.flutterwave.com/settings/apis
# Leave empty in dev to use mock mode (auto-successful payments).
# MUST be set in production — without SECRET_KEY the app runs in
# mock mode and accepts fake payments.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Webhook hash from https://dashboard.flutterwave.com/settings/webhooks
# Without this, webhook signature verification is disabled (dev only).
FLUTTERWAVE_WEBHOOK_HASH=
